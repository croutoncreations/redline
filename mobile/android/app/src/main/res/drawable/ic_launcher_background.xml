<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the app icon's dark gradient, drawn edge to edge so
  the launcher can mask it to any shape without exposing a corner.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="1024" android:endY="1024"
                android:type="linear">
                <item android:offset="0" android:color="#29292D" />
                <item android:offset="1" android:color="#111114" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
